# Copy this file to .env and fill in your Supabase project credentials.
# Find these values in your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
# Vars prefixed with EXPO_PUBLIC_ are inlined into the client bundle at build time.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
